---
import { github, repo } from '../data/site';
let stars: number | null = null;
try {
  const response = await fetch(`https://api.github.com/repos/${repo}`);
  if (response.ok) stars = (await response.json()).stargazers_count;
} catch {}
const label = (count: number | null) =>
  count === null ? 'Quill on GitHub' : `Quill on GitHub, ${count} ${count === 1 ? 'star' : 'stars'}`;
const compact = (count: number) => new Intl.NumberFormat('en', { notation: 'compact' }).format(count);
---
<a class="github" href={github} aria-label={label(stars)} data-repo={repo}>
  <svg class="github-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57l-.02-2.04c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.66-.3-5.46-1.33-5.46-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3" /></svg>
  <span class="github-stars" hidden={stars === null}>
    <svg class="github-star" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.6l1.95 3.95 4.36.63-3.16 3.08.75 4.34L8 11.55l-3.9 2.05.75-4.34L1.69 6.18l4.36-.63z" /></svg>
    <span class="github-count">{stars === null ? '' : compact(stars)}</span>
  </span>
</a>
<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.github[data-repo]')) {
    fetch(`https://api.github.com/repos/${link.dataset.repo}`)
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (typeof data?.stargazers_count !== 'number') return;
        const count: number = data.stargazers_count;
        link.querySelector('.github-count')!.textContent = new Intl.NumberFormat('en', { notation: 'compact' }).format(count);
        link.querySelector<HTMLElement>('.github-stars')!.hidden = false;
        link.setAttribute('aria-label', `Quill on GitHub, ${count} ${count === 1 ? 'star' : 'stars'}`);
      })
      .catch(() => {});
  }
</script>
